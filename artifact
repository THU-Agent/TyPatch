#!/usr/bin/env bash
# Run the binary-only TyPatch release directly from this checkout.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$repo_root/Analyzer/python${PYTHONPATH:+:$PYTHONPATH}"
export TYPATCH_TYPESTATE_BIN="${TYPATCH_TYPESTATE_BIN:-$repo_root/bin/typestate}"
exec python3 -m TyPatchLib.artifact_cli "$@"
